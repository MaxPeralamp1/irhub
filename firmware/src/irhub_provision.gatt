// IR Hub BLE provisioning service. Compiled into irhub_provision.h by
// pico_btstack_make_gatt_header (see CMakeLists.txt).
//
// UUIDs extend github.com/oyama/pico-ble-wifi-provisioning (7600-7603); 7604-7606
// add the MQTT broker and an explicit apply/forget command. These UUIDs, the
// status layout and the command bytes are mirrored in src/ble_provision.cpp and
// frontend/app.js (PROV)
//
// Every value requires an encrypted link, so a client's first access triggers
// LE Secure Connections "Just Works" pairing.

PRIMARY_SERVICE, GAP_SERVICE
CHARACTERISTIC, GAP_DEVICE_NAME, READ | DYNAMIC,

PRIMARY_SERVICE, GATT_SERVICE
CHARACTERISTIC, GATT_DATABASE_HASH, READ,

PRIMARY_SERVICE, be3d7600-0ea0-4e96-82e0-89aa6a3dc19f

// SSID, UTF-8, no terminator. Reads back the staged value.
CHARACTERISTIC, be3d7601-0ea0-4e96-82e0-89aa6a3dc19f, READ | WRITE | DYNAMIC | ENCRYPTION_KEY_SIZE_16,

// Wi-Fi password, UTF-8. Write-only: never readable. A zero-length write means
// an open network; not writing it at all keeps the current password.
CHARACTERISTIC, be3d7602-0ea0-4e96-82e0-89aa6a3dc19f, WRITE | DYNAMIC | ENCRYPTION_KEY_SIZE_16,

// Status, 8 bytes: state, reason (int8), ip[4], attempt, source.
CHARACTERISTIC, be3d7603-0ea0-4e96-82e0-89aa6a3dc19f, READ | NOTIFY | DYNAMIC | ENCRYPTION_KEY_SIZE_16,

// MQTT broker IPv4 address as text, e.g. "192.168.1.100".
CHARACTERISTIC, be3d7604-0ea0-4e96-82e0-89aa6a3dc19f, READ | WRITE | DYNAMIC | ENCRYPTION_KEY_SIZE_16,

// MQTT broker port, uint16 little-endian.
CHARACTERISTIC, be3d7605-0ea0-4e96-82e0-89aa6a3dc19f, READ | WRITE | DYNAMIC | ENCRYPTION_KEY_SIZE_16,

// Command, 1 byte: 0x01 apply staged settings, 0x02 forget stored settings.
CHARACTERISTIC, be3d7606-0ea0-4e96-82e0-89aa6a3dc19f, WRITE | DYNAMIC | ENCRYPTION_KEY_SIZE_16,
